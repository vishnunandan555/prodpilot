{
  "name": "prodpilot-desktop",
  "version": "1.0.0",
  "description": "ProdPilot Autonomous SRE Desktop Dashboard",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite --host 0.0.0.0 --port 5173 --strictPort\" \"wait-on -t 15000 http://localhost:5173 && electron . --ozone-platform-hint=auto\"",
    "start": "npm run electron:dev"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^0.344.0",
    "marked": "^18.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "vite": "^5.1.6",
    "wait-on": "^7.2.0"
  },
  "type": "module"
}
