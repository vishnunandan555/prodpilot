# ==============================================================================
# ProdPilot Environment Configuration
# ==============================================================================

# AI & Decision Engine API Keys
# JEV / OpenRouter API Key (Decision Engine Only)
JEV_API_KEY=
OPENROUTER_API_KEY=

# Google Gemini API Key (Context, RCA, & Patch Agent fallback)
GEMINI_API_KEY=

# Telegram Alerts & Notification Bot (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Remote Hosting & Webhooks (Optional)
RENDER_API_KEY=
RENDER_SERVICE_ID=
PRODPILOT_RENDER_URL=https://prodpilot.onrender.com

# API access control. Keep strict mode disabled for local development. Before
# exposing a tunnel, set PRODPILOT_REQUIRE_AUTH=true and list the exact public
# frontend origin(s), comma-separated (never use * with credentials).
PRODPILOT_REQUIRE_AUTH=false
PRODPILOT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional: provide a stable session-signing secret instead of storing one in
# the local SQLite settings database.
PRODPILOT_SESSION_SECRET=
PRODPILOT_SESSION_TTL_SECONDS=43200

# Target Service Environment (Defaults to active repository from database)
TARGET_REPO_PATH=
